{
  "name": "dsh-file-explorer",
  "version": "0.3.1",
  "description": "dsh 工作区文件浏览器：作为会话第三个 tab（对话 | 轨迹 | 文件）直接在 GUI 里浏览工作区目录并预览文件（文本/图片/PDF/二进制），不必切到 Finder。官方 bundle 形态，宿主侧通过 ctx.webServer 注册只读 /dsh-files 路由，浏览器侧注册进 conversation.view 视图环。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dompurify": "^3.4.14",
    "esbuild": "^0.25.12",
    "marked": "^18.0.11",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ice5kysl/dsh-file-explorer.git"
  },
  "homepage": "https://github.com/ice5kysl/dsh-file-explorer",
  "bugs": {
    "url": "https://github.com/ice5kysl/dsh-file-explorer/issues"
  }
}
